+++ b/main/radar_ftm.c
@@ -0,0 +1,146 @@
+// radar_ftm.c —— Wi-Fi FTM(802.11mc)RTT 测距。
+#include "radar_ftm.h"
+#include "radar_espnow.h"
+#include "radar_fusion.h"
+
+#include "esp_event.h"
+#include "esp_log.h"
+#include "esp_mac.h"
+#include "esp_timer.h"
+#include "esp_wifi.h"
+
+#include <string.h>
+#include <stdlib.h>
+
+static const char *TAG = "radar_ftm";
+
+// SoftAP(FTM responder)参数
+#define FTM_AP_SSID      "passradar"
+#define FTM_AP_PASSWORD  "passradar123"
+#define FTM_AP_CHANNEL   1
+// 每轮 session 的 burst 帧数
+#define FTM_FRAMES_PER_SESSION 16
+// 发起节流(2s)与结果有效期(5s)
+#define FTM_PERIOD_US    (2 * 1000 * 1000)
+#define FTM_VALID_US     (5 * 1000 * 1000)
+// RTT 皮秒 → 米:c/2 = 1.49896e-4 m/ps
+#define FTM_PS_TO_M      (1.49896e-4f)
+
+static volatile bool  s_paused        = false;
+static volatile float s_distance_m    = -1.0f;
+static volatile float s_spread_m      = 0.0f;
+static volatile int   s_rssi          = -127;
+static volatile int64_t s_valid_until = 0;
+static int64_t        s_last_session  = 0;
+static bool           s_initialized   = false;
+
+// ---------- FTM 报告事件(Wi-Fi 任务上下文) ----------
+
+static void ftm_event_handler(void *arg, esp_event_base_t base,
+                              int32_t id, void *data) {
+    (void)arg; (void)base;
+    if (id != WIFI_EVENT_FTM_REPORT) return;
+
+    wifi_event_ftm_report_t *report = (wifi_event_ftm_report_t *)data;
+    if (report->status == FTM_STATUS_SUCCESS &&
+        report->ftm_report_num_entries > 0 && report->ftm_report_data) {
+        // 逐 burst RTT → 距离,交纯逻辑中值滤波;帧 RSSI 取平均
+        unsigned n = report->ftm_report_num_entries;
+        float raw[32];
+        if (n > 32) n = 32;
+        int rssi_sum = 0;
+        for (unsigned i = 0; i < n; i++) {
+            raw[i] = (float)report->ftm_report_data[i].rtt * FTM_PS_TO_M;
+            rssi_sum += report->ftm_report_data[i].rssi;
+        }
+        float spread = 0.0f;
+        float d = radar_fusion_ftm_filter(raw, n, &spread);
+        if (d > 0.0f) {
+            s_distance_m = d;
+            s_spread_m = spread;
+            s_rssi = rssi_sum / (int)n;
+            s_valid_until = esp_timer_get_time() + FTM_VALID_US;
+        }
+        ESP_LOGI(TAG, "FTM ok: %.2fm (spread %.2f, rssi %d)",
+                 (double)s_distance_m, (double)s_spread_m, s_rssi);
+    } else {
+        ESP_LOGW(TAG, "FTM session status=%d", (int)report->status);
+    }
+    if (report->ftm_report_data) {
+        free(report->ftm_report_data);
+        report->ftm_report_data = NULL;
+    }
+}
+
+// ---------- 初始化 ----------
+
+esp_err_t radar_ftm_init(void) {
+    if (s_initialized) return ESP_OK;
+
+    // SoftAP:对端(同为 APSTA)可对其发起 FTM
+    wifi_config_t ap = {
+        .ap = {
+            .ssid = FTM_AP_SSID,
+            .ssid_len = sizeof(FTM_AP_SSID) - 1,
+            .password = FTM_AP_PASSWORD,
+            .channel = FTM_AP_CHANNEL,
+            .authmode = WIFI_AUTH_WPA2_PSK,
+            .ssid_hidden = 1,
+            .max_connection = 1,
+            .ftm_responder = true,
+        },
+    };
+    esp_err_t err = esp_wifi_set_config(WIFI_IF_AP, &ap);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "AP config: %s", esp_err_to_name(err));
+        return err;
+    }
+
+    err = esp_event_handler_register(WIFI_EVENT, WIFI_EVENT_FTM_REPORT,
+                                     ftm_event_handler, NULL);
+    if (err != ESP_OK) return err;
+
+    s_initialized = true;
+    ESP_LOGI(TAG, "FTM responder 就绪(softAP hidden)");
+    return ESP_OK;
+}
+
+// ---------- 周期发起 ----------
+
+void radar_ftm_pause(bool paused) { s_paused = paused; }
+
+void radar_ftm_tick(void) {
+    if (!s_initialized || s_paused) return;
+    if (radar_espnow_is_hopping()) return;  // 跳频中不发 FTM
+
+    int64_t now = esp_timer_get_time();
+    if (now - s_last_session < FTM_PERIOD_US) return;
+
+    uint8_t mac[6];
+    if (!radar_espnow_peer_mac(mac)) return;
+
+    wifi_ftm_initiator_cfg_t cfg = {
+        .frm_count = FTM_FRAMES_PER_SESSION,
+        .burst_period = 0,
+        .channel = FTM_AP_CHANNEL,
+    };
+    memcpy(cfg.resp_mac, mac, 6);
+
+    if (esp_wifi_ftm_initiate_session(&cfg) == ESP_OK) {
+        s_last_session = now;
+    }
+}
+
+// ---------- 查询 ----------
+
+bool radar_ftm_valid(void) {
+    return s_valid_until != 0 && esp_timer_get_time() < s_valid_until;
+}
+
+float radar_ftm_distance_m(void) {
+    return radar_ftm_valid() ? s_distance_m : -1.0f;
+}
+
+int radar_ftm_rssi(void) {
+    return radar_ftm_valid() ? s_rssi : -127;
+}
diff --git a/main/radar_ftm.h b/main/radar_ftm.h
new file mode 100644
index 0000000..2cc0284
--- /dev/null
+++ b/main/radar_ftm.h
@@ -0,0 +1,36 @@
+#pragma once
+
+// Wi-Fi FTM(802.11mc RTT)测距模块。
+//
+// 对称架构:双端均为 SoftAP + FTM Responder,同时作为 Initiator 周期性
+// 向对方发起 FTM session,各自得到本地 RTT 距离。滤波(中值 + IQR)
+// 在纯逻辑模块 radar_fusion 中完成。
+//
+// 约束:
+//   - ESP-IDF 中 FTM Responder 仅 AP 模式、Initiator 仅 STA 模式支持,
+//     故 Wi-Fi 需处于 APSTA(由 radar_espnow_init 设置);
+//   - FTM 与工作信道绑定:扫盘跳频期间须 radar_ftm_pause(true) 暂停发起;
+//   - RTT 精度与 RSSI 无关,但弱信号下失败率上升(实测 <-70dBm 明显)。
+
+#include "esp_err.h"
+#include <stdbool.h>
+#include <stdint.h>
+
+// 初始化:配置 SoftAP(FTM responder)并注册 FTM 事件。
+// 需在 radar_espnow_init() 之后调用。
+esp_err_t radar_ftm_init(void);
+
+// 扫盘期间暂停/恢复 FTM 发起(跳频会打断 session)。
+void radar_ftm_pause(bool paused);
+
+// 周期驱动(由 100ms 轮询调用;内部节流到每 2s 发起一次)。
+void radar_ftm_tick(void);
+
+// 最近一个有效窗口(5s)内是否有成功结果。
+bool radar_ftm_valid(void);
+
+// 最近一次滤波后距离(米)。无效时返回 -1。
+float radar_ftm_distance_m(void);
+
+// FTM 帧平均 RSSI(dBm)。无效时返回 -127。
+int radar_ftm_rssi(void);
diff --git a/main/radar_fusion.c b/main/radar_fusion.c
new file mode 100644
index 0000000..586fbdb
--- /dev/null
+++ b/main/radar_fusion.c
@@ -0,0 +1,188 @@
+// radar_fusion.c —— 测距/定向融合引擎实现。纯 C,无 ESP-IDF 依赖。
+#include "radar_fusion.h"
+#include "radar_sweep.h"  // RADAR_RSSI_MIN_VALID
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+// RSSI 是否"存在"(区分无数据与弱信号)
+#define RSSI_PRESENT_TH (-126.0f)
+// FTM 滤波单轮 burst 上限
+#define FTM_MAX_BURST 32
+// 严格 C11 下 math.h 不保证 M_PI
+#define FUSION_PI 3.14159265358979f
+
+float radar_env_path_loss_n(radar_env_t env) {
+    switch (env) {
+    case RADAR_ENV_INDOOR:     return 3.0f;
+    case RADAR_ENV_OBSTRUCTED: return 3.5f;
+    case RADAR_ENV_OUTDOOR:
+    default:                   return 2.2f;
+    }
+}
+
+// ---- 双向 RSSI ----
+
+bool radar_fusion_sym_valid(float rssi_ab, float rssi_ba) {
+    return rssi_ab > RSSI_PRESENT_TH && rssi_ba > RSSI_PRESENT_TH;
+}
+
+float radar_fusion_sym_rssi(float rssi_ab, float rssi_ba) {
+    return 0.5f * (rssi_ab + rssi_ba);
+}
+
+float radar_fusion_sym_distance(float rssi_sym, float tx_ref_sym, radar_env_t env) {
+    float n = radar_env_path_loss_n(env);
+    return powf(10.0f, (tx_ref_sym - rssi_sym) / (10.0f * n));
+}
+
+// ---- FTM 滤波 ----
+
+static int cmp_float(const void *a, const void *b) {
+    float fa = *(const float *)a, fb = *(const float *)b;
+    return (fa > fb) - (fa < fb);
+}
+
+float radar_fusion_ftm_filter(const float *raw_m, unsigned count, float *out_spread_m) {
+    if (!raw_m || count == 0) return RADAR_DIST_INVALID;
+
+    float buf[FTM_MAX_BURST];
+    unsigned n = count > FTM_MAX_BURST ? FTM_MAX_BURST : count;
+    memcpy(buf, raw_m, n * sizeof(float));
+    qsort(buf, n, sizeof(float), cmp_float);
+
+    float median = (n & 1u) ? buf[n / 2]
+                            : 0.5f * (buf[n / 2 - 1] + buf[n / 2]);
+    if (out_spread_m) {
+        unsigned q1 = n / 4;
+        unsigned q3 = (3 * n) / 4;
+        if (q3 >= n) q3 = n - 1;
+        *out_spread_m = buf[q3] - buf[q1];
+    }
+    return median;
+}
+
+bool radar_fusion_ftm_suspicious(float ftm_m, float rssi_m) {
+    return ftm_m > rssi_m * RADAR_FTM_SUSPICIOUS_RATIO &&
+           ftm_m > rssi_m + RADAR_FTM_SUSPICIOUS_MARGIN_M;
+}
+
+// ---- 融合主入口 ----
+
+radar_fusion_result_t radar_fusion_update(bool ftm_valid, float ftm_m,
+                                          float local_rssi_dbm, float peer_rssi_dbm,
+                                          float tx_ref_sym, radar_env_t env) {
+    radar_fusion_result_t r = {
+        .distance_m   = RADAR_DIST_INVALID,
+        .conf         = RADAR_CONF_OOR,
+        .sym_rssi_dbm = RADAR_RSSI_ABSENT,
+        .rssi_dist_m  = RADAR_DIST_INVALID,
+        .ftm_used     = false,
+    };
+
+    bool local_ok = local_rssi_dbm > RSSI_PRESENT_TH;
+    if (!local_ok) return r;
+
+    bool peer_ok = peer_rssi_dbm > RSSI_PRESENT_TH;
+    float sym = peer_ok ? radar_fusion_sym_rssi(local_rssi_dbm, peer_rssi_dbm)
+                        : local_rssi_dbm;
+    r.sym_rssi_dbm = sym;
+
+    float rssi_d = radar_fusion_sym_distance(sym, tx_ref_sym, env);
+    r.rssi_dist_m = rssi_d;
+
+    // 弱信号守卫:对称 RSSI 低于最小有效值 → 超界(保留距离供参考)
+    if (sym < RADAR_RSSI_MIN_VALID) {
+        r.distance_m = rssi_d;
+        r.conf = RADAR_CONF_OOR;
+        return r;
+    }
+
+    // FTM 主测距:可用且不可疑时加权融合;疑似反射径则降级纯 RSSI
+    if (ftm_valid && ftm_m > 0.0f) {
+        if (radar_fusion_ftm_suspicious(ftm_m, rssi_d)) {
+            r.distance_m = rssi_d;
+            r.conf = RADAR_CONF_MED;
+            r.ftm_used = false;
+        } else {
+            r.distance_m = RADAR_FTM_FUSION_WEIGHT * ftm_m +
+                           (1.0f - RADAR_FTM_FUSION_WEIGHT) * rssi_d;
+            r.ftm_used = true;
+            bool symmetric_link = peer_ok &&
+                fabsf(local_rssi_dbm - peer_rssi_dbm) <= RADAR_SYM_MAX_GAP_DB;
+            r.conf = symmetric_link ? RADAR_CONF_HIGH : RADAR_CONF_MED;
+        }
+        return r;
+    }
+
+    r.distance_m = rssi_d;
+    r.conf = peer_ok ? RADAR_CONF_MED : RADAR_CONF_LOW;
+    return r;
+}
+
+// ---- 角度工具 ----
+
+float radar_fusion_angle_diff(float a_deg, float b_deg) {
+    float d = fmodf(fabsf(a_deg - b_deg), 360.0f);
+    if (d > 180.0f) d = 360.0f - d;
+    return d;
+}
+
+float radar_fusion_circular_mean(const float *angles_deg, unsigned count) {
+    if (!angles_deg || count == 0) return RADAR_ANGLE_INVALID;
+    float sx = 0.0f, sy = 0.0f;
+    for (unsigned i = 0; i < count; i++) {
+        float rad = angles_deg[i] * FUSION_PI / 180.0f;
+        sx += cosf(rad);
+        sy += sinf(rad);
+    }
+    float ang = atan2f(sy, sx) * 180.0f / FUSION_PI;
+    if (ang < 0.0f) ang += 360.0f;
+    return ang;
+}
+
+float radar_fusion_angle_pair(float local_deg, float peer_deg) {
+    bool la = local_deg >= 0.0f;
+    bool pa = peer_deg >= 0.0f;
+    if (!la && !pa) return RADAR_ANGLE_INVALID;
+    if (!la) return peer_deg;
+    if (!pa) return local_deg;
+    float arr[2] = { local_deg, peer_deg };
+    return radar_fusion_circular_mean(arr, 2);
+}
+
+// ---- 环境自适应估计 ----
+
+void radar_env_est_init(radar_env_est_t *est) {
+    est->min_rssi = 0.0f;
+    est->max_rssi = -200.0f;
+    est->count = 0;
+    est->env = RADAR_ENV_OUTDOOR;
+}
+
+radar_env_t radar_env_est_update(radar_env_est_t *est, float rssi_dbm) {
+    if (!est || rssi_dbm <= RSSI_PRESENT_TH) return est ? est->env : RADAR_ENV_OUTDOOR;
+
+    if (est->count == 0 || rssi_dbm < est->min_rssi) est->min_rssi = rssi_dbm;
+    if (est->count == 0 || rssi_dbm > est->max_rssi) est->max_rssi = rssi_dbm;
+    est->count++;
+
+    // 窗口满:按峰峰抖动评估环境并重置窗口(周期性重估)
+    if (est->count >= RADAR_ENV_WINDOW) {
+        float p2p = est->max_rssi - est->min_rssi;
+        est->env = (p2p > RADAR_ENV_P2P_INDOOR_DB) ? RADAR_ENV_INDOOR
+                                                   : RADAR_ENV_OUTDOOR;
+        est->count = 0;
+        est->min_rssi = 0.0f;
+        est->max_rssi = -200.0f;
+    }
+    return est->env;
+}
+
+// ---- 1m 标定 ----
+
+float radar_fusion_calib_ref(float sym_rssi_at_1m) {
+    if (sym_rssi_at_1m > -30.0f) return -30.0f;
+    if (sym_rssi_at_1m < -60.0f) return -60.0f;
+    return sym_rssi_at_1m;
+}
diff --git a/main/radar_fusion.h b/main/radar_fusion.h
new file mode 100644
index 0000000..0d8988b
--- /dev/null
+++ b/main/radar_fusion.h
@@ -0,0 +1,123 @@
+#pragma once
+
+// 测距/定向融合引擎 —— 纯数学模块,无 ESP-IDF 依赖,可 host test。
+//
+// 融合观测源:
+//   - 双向 RSSI(本端测对端 + 对端测本端,经 ESP-NOW 回传)
+//   - Wi-Fi FTM(802.11mc RTT 时间戳测距)
+//   - 双端扫盘角度(环形均值融合)
+//   - 环境自适应路径损耗指数
+//
+// 设计原则:观测量优先于滤波器;所有规则可单测。
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// ---- 置信度等级 ----
+typedef enum {
+    RADAR_CONF_OOR = 0,  // 超界/无链路
+    RADAR_CONF_LOW,      // 单链路 RSSI(无可信对端数据)
+    RADAR_CONF_MED,      // 双向 RSSI 融合,或 FTM 存疑(疑似反射径)
+    RADAR_CONF_HIGH,     // FTM 有效且与双向 RSSI 一致
+} radar_confidence_t;
+
+// ---- 环境模型(路径损耗指数 n) ----
+typedef enum {
+    RADAR_ENV_OUTDOOR = 0,  // n = 2.2 室外开阔
+    RADAR_ENV_INDOOR,       // n = 3.0 室内多径
+    RADAR_ENV_OBSTRUCTED,   // n = 3.5 有明显遮挡
+} radar_env_t;
+
+// ---- 无效值约定 ----
+#define RADAR_RSSI_ABSENT   (-127.0f)  // 无对端数据
+#define RADAR_DIST_INVALID  (-1.0f)    // 距离不可用
+#define RADAR_ANGLE_INVALID (-1.0f)    // 角度不可用
+
+// FTM 与 RSSI 距离分歧超过该比例(且超出 2m 滞回)判为疑似反射径
+#define RADAR_FTM_SUSPICIOUS_RATIO 1.8f
+#define RADAR_FTM_SUSPICIOUS_MARGIN_M 2.0f
+// FTM/RSSI 加权融合中 FTM 的权重
+#define RADAR_FTM_FUSION_WEIGHT 0.7f
+// 双向 RSSI 差异超过该值(dB)说明链路不对称,不给 HIGH
+#define RADAR_SYM_MAX_GAP_DB 8.0f
+// 环境检测:RSSI 峰峰抖动超过该值(dB)判为室内
+#define RADAR_ENV_P2P_INDOOR_DB 8.0f
+// 环境估计窗口(样本数,100ms 喂一次 ≈ 8s)
+#define RADAR_ENV_WINDOW 80
+
+// 环境对应的路径损耗指数
+float radar_env_path_loss_n(radar_env_t env);
+
+// ---- 双向 RSSI ----
+
+// 双向 RSSI 是否都有效(均非 ABSENT)
+bool radar_fusion_sym_valid(float rssi_ab, float rssi_ba);
+
+// 双向 RSSI 对称平均(dB 域算术平均)。
+// 对置消除两端天线方向图与发射功率差异。
+float radar_fusion_sym_rssi(float rssi_ab, float rssi_ba);
+
+// 对称 RSSI → 距离(米)。tx_ref_sym 为 1m 处对称参考值。
+float radar_fusion_sym_distance(float rssi_sym, float tx_ref_sym, radar_env_t env);
+
+// ---- FTM 滤波 ----
+
+// 一轮 burst 的原始 RTT 距离(米)→ 中值滤波。
+// out_spread_m 输出四分位距(IQR),可为 NULL。
+// count==0 返回 RADAR_DIST_INVALID。
+float radar_fusion_ftm_filter(const float *raw_m, unsigned count, float *out_spread_m);
+
+// 反射径判别:ftm_m > rssi_m * ratio 且 ftm_m > rssi_m + margin 时存疑。
+bool radar_fusion_ftm_suspicious(float ftm_m, float rssi_m);
+
+// ---- 融合主入口 ----
+
+typedef struct {
+    float distance_m;        // 融合距离(无效时 RADAR_DIST_INVALID)
+    radar_confidence_t conf; // 置信度
+    float sym_rssi_dbm;      // 对称 RSSI(供显示)
+    float rssi_dist_m;       // 纯 RSSI 推算距离(供调试/降级)
+    bool  ftm_used;          // 本次是否采纳了 FTM
+} radar_fusion_result_t;
+
+// 距离融合。
+//   ftm_valid/ftm_m:       FTM 是否有有效结果及其距离
+//   local_rssi_dbm:        本端滤波后 RSSI(无信号传 RADAR_RSSI_ABSENT)
+//   peer_rssi_dbm:         对端回传的 RSSI(无数据传 RADAR_RSSI_ABSENT)
+//   tx_ref_sym:            1m 对称参考(标定值,默认 -42)
+//   env:                   环境模型
+radar_fusion_result_t radar_fusion_update(bool ftm_valid, float ftm_m,
+                                          float local_rssi_dbm, float peer_rssi_dbm,
+                                          float tx_ref_sym, radar_env_t env);
+
+// ---- 角度工具 ----
+
+// 环形角度差(0~180°)
+float radar_fusion_angle_diff(float a_deg, float b_deg);
+
+// 环形均值(向量平均),count==0 返回 RADAR_ANGLE_INVALID
+float radar_fusion_circular_mean(const float *angles_deg, unsigned count);
+
+// 双端角度融合:一端无效返回另一端;均无效返回 RADAR_ANGLE_INVALID;
+// 均有效返回环形均值(分歧大小由调用方用 radar_fusion_angle_diff 评估)。
+float radar_fusion_angle_pair(float local_deg, float peer_deg);
+
+// ---- 环境自适应估计 ----
+
+typedef struct {
+    float min_rssi;
+    float max_rssi;
+    unsigned count;      // 窗口内已计数
+    radar_env_t env;
+} radar_env_est_t;
+
+void radar_env_est_init(radar_env_est_t *est);
+
+// 每 100ms 喂一次滤波后 RSSI,返回当前环境判断。
+// 窗口满后按滑动窗口滚动估计。
+radar_env_t radar_env_est_update(radar_env_est_t *est, float rssi_dbm);
+
+// ---- 1m 标定 ----
+
+// 1m 处测得的对称 RSSI 即 tx_ref_sym(钳位到 -60~-30dBm 防止误标定)。
+float radar_fusion_calib_ref(float sym_rssi_at_1m);
diff --git a/main/radar_sweep.c b/main/radar_sweep.c
index ef3cb9c..33916f8 100644
--- a/main/radar_sweep.c
+++ b/main/radar_sweep.c
@@ -1,5 +1,16 @@
+// radar_sweep.c —— 扫盘峰值检测与距离估算。纯 C,无 ESP-IDF 依赖。
 #include "radar_sweep.h"
+#include "radar_fusion.h"
 #include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+// 单信道分组采样上限(快跳下每信道约 27 个样本,64 充裕)
+#define SWEEP_GROUP_CAP 64
+// 信道分组检测的最小样本数
+#define SWEEP_GROUP_MIN 6
+// 严格 C11 下 math.h 不保证 M_PI
+#define SWEEP_PI 3.14159265358979f
 
 float radar_sweep_calc_distance(float rssi) {
     // 自由空间路径损耗:distance = 10^((txPower - rssi) / (10 * n))
@@ -36,3 +47,198 @@ float radar_sweep_peak_rssi(const radar_sample_t *samples, unsigned count) {
     }
     return max_rssi;
 }
+
+// ---- v2 增强 ----
+
+float radar_sweep_peak_angle_interp(const radar_sample_t *samples, unsigned count,
+                                    uint32_t sweep_duration_ms) {
+    if (!samples || count == 0 || sweep_duration_ms == 0) return -1.0f;
+
+    unsigned mi = 0;
+    for (unsigned i = 1; i < count; i++) {
+        if (samples[i].rssi > samples[mi].rssi) mi = i;
+    }
+
+    float t = (float)samples[mi].timestamp_ms;
+
+    // 抛物线插值:峰不在边界且开口向下时,用相邻三点估计真实峰位
+    if (mi > 0 && mi < count - 1) {
+        float y0 = samples[mi - 1].rssi;
+        float y1 = samples[mi].rssi;
+        float y2 = samples[mi + 1].rssi;
+        float denom = y0 - 2.0f * y1 + y2;
+        if (denom < 0.0f) {
+            float delta = 0.5f * (y0 - y2) / denom;  // [-0.5, 0.5] 样本偏移
+            float dt = 0.5f * ((float)samples[mi + 1].timestamp_ms -
+                               (float)samples[mi - 1].timestamp_ms);
+            t += delta * dt;
+        }
+    }
+
+    float ratio = t / (float)sweep_duration_ms;
+    if (ratio < 0.0f) ratio = 0.0f;
+    if (ratio > 1.0f) ratio = 1.0f;
+    return ratio * 360.0f;
+}
+
+static int cmp_float(const void *a, const void *b) {
+    float fa = *(const float *)a, fb = *(const float *)b;
+    return (fa > fb) - (fa < fb);
+}
+
+float radar_sweep_peak_prominence(const radar_sample_t *samples, unsigned count) {
+    if (!samples || count == 0) return 0.0f;
+
+    float buf[RADAR_MAX_SAMPLES_CAP];
+    unsigned n = count > RADAR_MAX_SAMPLES_CAP ? RADAR_MAX_SAMPLES_CAP : count;
+    for (unsigned i = 0; i < n; i++) buf[i] = samples[i].rssi;
+    qsort(buf, n, sizeof(float), cmp_float);
+
+    float baseline = buf[n / 10];  // P10 分位
+    float peak = buf[n - 1];
+    return peak - baseline;
+}
+
+uint8_t radar_sweep_channel_at(uint32_t t_ms, uint32_t sweep_duration_ms) {
+    (void)sweep_duration_ms;
+    // 快跳轮询:每 RADAR_SWEEP_HOP_DWELL_MS 换一个信道,1/6/11 循环。
+    // 每个信道都能覆盖完整 360° 旋转,从而获得独立的方向图用于投票。
+    uint32_t slot = t_ms / RADAR_SWEEP_HOP_DWELL_MS;
+    switch (slot % 3u) {
+    case 0:  return RADAR_SWEEP_CH_A;
+    case 1:  return RADAR_SWEEP_CH_B;
+    default: return RADAR_SWEEP_CH_C;
+    }
+}
+
+// ---- 一次谐波最小二乘拟合 ----
+
+// 3×3 线性方程组求解(高斯消元 + 部分主元)。退化返回 false。
+static bool solve3(float a[3][3], float b[3], float x[3]) {
+    for (unsigned col = 0; col < 3; col++) {
+        unsigned piv = col;
+        for (unsigned row = col + 1; row < 3; row++) {
+            if (fabsf(a[row][col]) > fabsf(a[piv][col])) piv = row;
+        }
+        if (fabsf(a[piv][col]) < 1e-6f) return false;
+        if (piv != col) {
+            for (unsigned k = col; k < 3; k++) {
+                float tmp = a[col][k]; a[col][k] = a[piv][k]; a[piv][k] = tmp;
+            }
+            float tmp = b[col]; b[col] = b[piv]; b[piv] = tmp;
+        }
+        for (unsigned row = col + 1; row < 3; row++) {
+            float f = a[row][col] / a[col][col];
+            for (unsigned k = col; k < 3; k++) a[row][k] -= f * a[col][k];
+            b[row] -= f * b[col];
+        }
+    }
+    for (int row = 2; row >= 0; row--) {
+        float s = b[row];
+        for (unsigned k = (unsigned)row + 1; k < 3; k++) s -= a[row][k] * x[k];
+        x[row] = s / a[row][row];
+    }
+    return true;
+}
+
+float radar_sweep_harmonic_angle(const radar_sample_t *samples, unsigned count,
+                                 uint32_t sweep_duration_ms, float *out_amplitude_db) {
+    if (!samples || count < SWEEP_GROUP_MIN || sweep_duration_ms == 0) return -1.0f;
+
+    // 法方程:y = a + b·cosθ + c·sinθ,θ = 2π·t/duration
+    float s_c = 0.0f, s_s = 0.0f;             // Σcos, Σsin
+    float s_cc = 0.0f, s_ss = 0.0f, s_cs = 0.0f;
+    float s_y = 0.0f, s_yc = 0.0f, s_ys = 0.0f;
+    for (unsigned i = 0; i < count; i++) {
+        float th = 2.0f * SWEEP_PI * (float)samples[i].timestamp_ms /
+                   (float)sweep_duration_ms;
+        float c = cosf(th), sn = sinf(th), y = samples[i].rssi;
+        s_c += c;       s_s += sn;
+        s_cc += c * c;  s_ss += sn * sn;  s_cs += c * sn;
+        s_y += y;       s_yc += y * c;    s_ys += y * sn;
+    }
+
+    float n = (float)count;
+    float a[3][3] = {
+        { n,    s_c,  s_s  },
+        { s_c,  s_cc, s_cs },
+        { s_s,  s_cs, s_ss },
+    };
+    float b[3] = { s_y, s_yc, s_ys };
+    float x[3];
+    if (!solve3(a, b, x)) return -1.0f;
+
+    float amp = sqrtf(x[1] * x[1] + x[2] * x[2]);
+    if (out_amplitude_db) *out_amplitude_db = amp;
+
+    float ang = atan2f(x[2], x[1]) * 180.0f / SWEEP_PI;
+    if (ang < 0.0f) ang += 360.0f;
+    return ang;
+}
+
+unsigned radar_sweep_channel_angles(const radar_sample_t *samples, unsigned count,
+                                    uint32_t sweep_duration_ms,
+                                    float *out_angles, unsigned max_out) {
+    if (!samples || !out_angles || count == 0 ||
+        sweep_duration_ms == 0 || max_out == 0) return 0;
+
+    // 收集出现过的信道值(最多 4 种,含 0=未标记)
+    uint8_t chans[4];
+    unsigned nch = 0;
+    for (unsigned i = 0; i < count && nch < 4; i++) {
+        uint8_t ch = samples[i].channel;
+        bool seen = false;
+        for (unsigned j = 0; j < nch; j++) {
+            if (chans[j] == ch) { seen = true; break; }
+        }
+        if (!seen) chans[nch++] = ch;
+    }
+
+    unsigned n = 0;
+    for (unsigned c = 0; c < nch && n < max_out; c++) {
+        radar_sample_t sub[SWEEP_GROUP_CAP];
+        unsigned m = 0;
+        for (unsigned i = 0; i < count && m < SWEEP_GROUP_CAP; i++) {
+            if (samples[i].channel == chans[c]) sub[m++] = samples[i];
+        }
+        // 谐波拟合测角;峰-峰幅度(2×拟合幅度)不足视为该信道无有效峰
+        float amp = 0.0f;
+        float ang = radar_sweep_harmonic_angle(sub, m, sweep_duration_ms, &amp);
+        if (ang < 0.0f) continue;
+        if (2.0f * amp < RADAR_SWEEP_MIN_PROMINENCE_DB) continue;
+        out_angles[n++] = ang;
+    }
+    return n;
+}
+
+float radar_sweep_angle_vote(const float *angles, unsigned count, float *out_spread_deg) {
+    if (!angles || count == 0) return -1.0f;
+    if (count == 1) {
+        if (out_spread_deg) *out_spread_deg = 0.0f;
+        return angles[0];
+    }
+
+    // 环形中值:与其他角度环形差之和最小者获胜
+    unsigned best = 0;
+    float best_cost = 1e9f;
+    for (unsigned i = 0; i < count; i++) {
+        float cost = 0.0f;
+        for (unsigned j = 0; j < count; j++) {
+            cost += radar_fusion_angle_diff(angles[i], angles[j]);
+        }
+        if (cost < best_cost) {
+            best_cost = cost;
+            best = i;
+        }
+    }
+
+    if (out_spread_deg) {
+        float spread = 0.0f;
+        for (unsigned j = 0; j < count; j++) {
+            float d = radar_fusion_angle_diff(angles[best], angles[j]);
+            if (d > spread) spread = d;
+        }
+        *out_spread_deg = spread;
+    }
+    return angles[best];
+}
