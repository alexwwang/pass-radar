+static unsigned build_pattern(radar_sample_t *out, unsigned max,
+                              uint32_t sweep_ms, float peak_time_ms, float depth_db,
+                              uint8_t channel) {
+    unsigned n = 0;
+    for (uint32_t t = 0; t < sweep_ms && n < max; t += 50) {
