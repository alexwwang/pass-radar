+
+    float angles[4];
+    unsigned cnt = radar_sweep_channel_angles(samples, n, SWEEP_MS, angles, 4);
+    CHECK(cnt == 3, "should detect 3 channel angles, got %u", cnt);
+
+    // 投票(环形中值)应选中 180° 附近,抑制 ch6 假峰
+    float spread = -1.0f;
