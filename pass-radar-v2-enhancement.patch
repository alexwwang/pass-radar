@@ -0,0 +1,24 @@
+#pragma once
+
+// BLE 长距哨兵链路(NimBLE + BLE 5.0 Coded PHY)。
+//
+// 角色:辅助链路,非主测距源。
+//   - Wi-Fi/ESP-NOW 判超界(RSSI < -88dBm)后,BLE Coded PHY 链路仍可
+//     达(灵敏度约 +9dB,开阔场量程 3 倍于 Wi-Fi),提供"远/近"两档提示;
